{
  "name": "hi-dsh",
  "version": "0.2.3",
  "description": "hi-dsh: a dsh plugin marketplace — discover, catalog, and install dsh plugins.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "client",
    "cordis.patch.yml",
    "tsdown.config.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "prepare": "tsdown"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-theme"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "deepseek-ai",
    "plugin",
    "marketplace"
  ],
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  },
  "devDependencies": {
    "tsdown": "^0.22.14"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hi-dsh/hi-dsh.git"
  },
  "bugs": {
    "url": "https://github.com/hi-dsh/hi-dsh/issues"
  },
  "homepage": "https://github.com/hi-dsh/hi-dsh#readme"
}
